      "title": "Drive Health Table",
      "type": "table",
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"smart\")\n  |> filter(fn: (r) => r.hostname =~ /${hostname:regex}/)\n  |> filter(fn: (r) => r.device =~ /${device:regex}/)\n  |> filter(fn: (r) => r._field == \"temperature\" or r._field == \"power_on_hours\" or r._field == \"reallocated_sector_count\" or r._field == \"percentage_used\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"device\", \"model\", \"serial\", \"type\", \"temperature\", \"power_on_hours\", \"reallocated_sector_count\", \"percentage_used\"])",
